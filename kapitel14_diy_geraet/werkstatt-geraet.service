# systemd-Unit für das Werkstattgerät
#   sudo cp werkstatt-geraet.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now werkstatt-geraet
[Unit]
Description=DIY-Werkstattgerät für openHAB (REST API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/openhab-python-entwicklung
EnvironmentFile=/home/pi/openhab-python-entwicklung/.env
ExecStart=/home/pi/openhab-python-entwicklung/.venv/bin/python kapitel14_diy_geraet/werkstatt_geraet.py --gpio
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
