# Kopieren nach openhab.env, Token eintragen und vor den Beispielen laden:
#   source openhab.env
# openhab.env steht in .gitignore – Tokens gehören nicht ins Repository!
export OPENHAB_URL=http://127.0.0.1:8080
export OPENHAB_TOKEN=oh.buch.xxxxxxxxxxxxxxxx
# Alternativ Basic Authentication (in openHAB erst freischalten), nur Kapitel 10:
# export OPENHAB_USER=admin
# export OPENHAB_PASSWORD=geheim
